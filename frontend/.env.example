# Base URL API Backend (Express.js)
NUXT_PUBLIC_API_BASE=http://localhost:3001

# Mock users for frontend development only.
# Format: username:role:aum:password, separated by |
# Catatan: superadmin PERTAMA = akun inti (tidak dapat dikelola/dihapus lewat UI).
# Maksimal 2 superadmin (inti + backup); keduanya hanya bisa didaftarkan di sini.
NUXT_PUBLIC_USERS=superadmin:superadmin::change-me|superadmin_backup:superadmin::change-me|admin_karangharjo:admin:SD Muhammadiyah Karangharjo:change-me
